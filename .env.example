# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Generation ONLY: freellmapi (local router -> free cloud LLM) -------------
# freellmapi runs on this laptop; our code talks to its local /v1 endpoint.
LLM_BASE_URL=http://localhost:3001/v1
LLM_API_KEY=freellmapi-your-unified-key

# Chat model: auto, auto:fast, auto:smart, or a pinned model id
LLM_MODEL=auto:fast

# --- Embeddings: LOCAL, no API key, no network --------------------------------
# Computed on this machine with sentence-transformers.
# Pin the model + dimension: changing either later requires rebuilding the vector store.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
