# Copy this file to .env and fill in real values. NEVER commit .env.

# freellmapi endpoint (self-hosted default)
LLM_BASE_URL=http://localhost:3001/v1
LLM_API_KEY=freellmapi-your-unified-key

# Chat model: auto, auto:fast, auto:smart, or a pinned model id
LLM_MODEL=auto:fast

# Embeddings: PIN ONE family per vector store + its dimension
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024